# topquant_ksk QuantDB 설정 템플릿.
# 이 파일을 복사해서 `.env` 로 저장하고 본인 값을 직접 채우세요. (.env 는 gitignore 됨 — commit 금지)
# QuantDB.from_env() 가 .env 를 로드해 아래 키를 읽습니다. 값은 여기 적지 말 것(변수명만).

# ===== 접속 계정 (필수) =====
# 실제 필수 입력은 이 둘(credential). 나머지는 기본값이 있어 비워둬도 됨.
DB_USER=
DB_PASSWORD=
# 데이터베이스명 (선택, 기본 quantdb). 다른 DB 면 설정.
DB_NAME=

# ===== Cloudflare 터널 =====
# 터널 Public Hostname (선택, 기본 shquantdb.alphawaves.vip). 다른 배포본이면 설정.
TUNNEL_HOSTNAME=
# 로컬 포워더 포트 (선택, 기본 15432)
TUNNEL_PORT=

# cloudflared.exe 경로 (선택). 보통 비워두면 PATH/winget 에서 자동탐지됩니다.
# 자동탐지 실패 시에만 본인 PC 의 절대경로를 지정하세요.
CLOUDFLARED_BIN=

# ===== Cloudflare Access 서비스토큰 (선택) =====
# 현재 shquantdb.alphawaves.vip 는 토큰 없이도 접속됨(실측 확인) → 비워둬도 됨.
# 터널 호스트에 CF Access 정책이 켜진 경우에만 필요. 값이 있으면 cloudflared 에 주입되고,
# Access 미적용이면 무시되므로 그냥 둬도 무해하다.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
